# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000            # public URL of the app, no trailing slash (production: https://app.scaleitads.com)
PLATFORM_NAME=OneX                       # your brand name shown everywhere
# PLATFORM_BY=ScaleitAds                 # "OneX by ScaleitAds" in the sidebar, auth pages, account emails (empty = hide)
# PLATFORM_BY_URL=https://scaleitads.com # where that attribution links
APP_SECRET=change-me-to-64-random-chars  # signs sessions/links, encrypts tokens. NEVER change after launch.
SETUP_TOKEN=change-me                    # open /signup?setup=<this> to create the owner account
# ROOT_DOMAIN=onex.app                   # sites get <slug>.onex.app (wildcard DNS). Leave empty to use /s/<slug>
# APP_HOSTS=app.onex.app                 # extra hostnames that serve the dashboard

# The agency website (ScaleitAds) and /skool. On these hosts "/" is the agency home page, www redirects
# to the apex, and app paths (/app, /login, /signup, /join, /api ...) keep working. On the app host,
# "/" opens /app and the agency pages redirect here. Locally (localhost) every page works at its path:
# /home (agency home), /watch, /privacy, /terms, /skool. To preview the marketing host itself locally:
# MARKETING_HOSTS=scaleitads.localhost,www.scaleitads.localhost, then open http://scaleitads.localhost:3000
# MARKETING_HOSTS=scaleitads.com,www.scaleitads.com

# ScaleitAds /apply on our own stack instead of GoHighLevel. With both set (and that calendar switched
# on), /apply posts each lead to /api/scaleitads/apply (into this workspace's CRM: contact, tags "apply"
# + a spend band, a deal in the first pipeline stage, "Lead created" automations) and embeds the
# booking page /b/<workspace>/<calendar> in its card. Unset or not matching: GoHighLevel, as before.
# The slugs are the two parts of the calendar's booking link: .../b/<SCALEITADS_WORKSPACE>/<SCALEITADS_CALENDAR>
# SCALEITADS_WORKSPACE=scaleitads
# SCALEITADS_CALENDAR=free-ad-account-check

# Database: leave empty locally (embedded PGlite in .data/). Use Postgres in production
# (Neon: the pooled connection string, the host with "-pooler").
# DATABASE_URL=postgres://user:pass@host:5432/db
# DB_POOL_MAX=5
# PGLITE_DIR=.data/pglite

# Background jobs: /api/cron/tick runs every minute, called with "Authorization: Bearer <CRON_SECRET>"
# (Vercel Cron on the Pro plan, or an external cron service on Hobby; see DEPLOY.md).
CRON_SECRET=change-me
# JOBS_INLINE=1                           # process jobs right after requests (default in dev)

# ---------------------------------------------------------------------------
# AI (Claude) — launch kits, lead scoring, reply drafts, ad reviews
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Email: console (logs only) | postmark | resend
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=hello@yourdomain.com   # must be a verified sender/domain
# POSTMARK_SERVER_TOKEN=
# POSTMARK_BROADCAST_STREAM=broadcast
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Skool access
# ---------------------------------------------------------------------------
# Zapier "Skool -> New Paid Member" posts to /api/webhooks/skool?secret=...
SKOOL_WEBHOOK_SECRET=change-me
# Where "Join on Skool" buttons point
# SKOOL_GROUP_URL=https://www.skool.com/0-to-1x-academy-9129/about
# Optional: invite /join buyers into Skool (Zapier catch hook -> Skool "Invite Member")
# SKOOL_INVITE_WEBHOOK_URL=
# New signups can use the app for this many days while their membership is confirmed (0 = off)
# WELCOME_ACCESS_DAYS=3

# ---------------------------------------------------------------------------
# Meta (Instagram, Messenger, WhatsApp, Conversions API)
# ---------------------------------------------------------------------------
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=any-random-string     # also paste it in the App Dashboard webhook settings
# META_GRAPH_VERSION=v23.0
# META_LOGIN_CONFIG_ID=                   # Facebook Login for Business configuration ID (optional)
# META_WA_CONFIG_ID=                      # WhatsApp Embedded Signup configuration ID
# META_AD_LIBRARY_TOKEN=                  # Ad research live search: user token from an identity-confirmed account (facebook.com/ads/library/api)

# ---------------------------------------------------------------------------
# Payments (Stripe)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_GROWTH=price_...           # monthly Growth plan
# STRIPE_PRICE_AGENCY=price_...           # monthly Agency plan
# STRIPE_PRICE_MEMBER=price_...           # app access sold directly on /join
# MEMBER_PRICE_LABEL=$29/month

# ---------------------------------------------------------------------------
# Custom domains (Vercel) and SMS (Twilio)
# ---------------------------------------------------------------------------
# "Get a domain" button: your registrar affiliate link (or set it in Admin). {domain} = the member's search.
# DOMAIN_AFFILIATE_URL=https://www.namecheap.com/domains/registration/results/?domain={domain}&affId=YOUR_ID
# DOMAIN_AFFILIATE_PARTNER=Namecheap
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
